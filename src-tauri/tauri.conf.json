{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "toyol",
  "mainBinaryName": "toyol",
  "version": "../package.json",
  "identifier": "com.toyol.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "toyol",
        "width": 420,
        "height": 560,
        "minWidth": 280,
        "minHeight": 220,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "toyol",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ2NDlBNUQzRUFEQTYyQzYKUldUR1l0cnEwNlZKUmkrMHlBMllqUGxhc2FEVDg4MHhZMWZyamVpRE5YNjdGNkIwYVNrWDQ0M3gK",
      "endpoints": ["https://github.com/thakurabhishek7283/toyol/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
