e="1" as="geometry"><Array as="points"><mxPoint x="968" y="1052"/><mxPoint x="1300" y="1052"/><mxPoint x="1300" y="1022"/></Array></mxGeometry></mxCell><mxCell id="arch-70" value="③ ④ user32 · gdi32 · DWM" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-42" target="arch-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="285" y="970"/><mxPoint x="285" y="775"/></Array></mxGeometry></mxCell><mxCell id="arch-71" value="global&lt;br&gt;shortcuts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontSize=10;endArrow=classic;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="arch-36" target="arch-9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="308" y="832"/><mxPoint x="308" y="907"/></Array></mxGeometry></mxCell><mxCell id="arch-72" value="Legend" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="560" height="150" as="geometry"/></mxCell><mxCell id="arch-73" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="arch-72"><mxGeometry x="15" y="35" width="22" height="18" as="geometry"/></mxCell><mxCell id="arch-74" value="Frontend (WebView2)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="arch-72"><mxGeometry x="45" y="32" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-75" value="" style="rounded=1;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="arch-72"><mxGeometry x="285" y="35" width="22" height="18" as="geometry"/></mxCell><mxCell id="arch-76" value="Rust core" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="arch-72"><mxGeometry x="315" y="32" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-77" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="arch-72"><mxGeometry x="15" y="69" width="22" height="18" as="geometry"/></mxCell><mxCell id="arch-78" value="Local data on this PC" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="arch-72"><mxGeometry x="45" y="66" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-79" value="" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="arch-72"><mxGeometry x="285" y="69" width="22" height="18" as="geometry"/></mxCell><mxCell id="arch-80" value="External service" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="arch-72"><mxGeometry x="315" y="66" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-81" value="" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="arch-72"><mxGeometry x="15" y="103" width="22" height="18" as="geometry"/></mxCell><mxCell id="arch-82" value="Windows / hardware" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="arch-72"><mxGeometry x="45" y="100" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-83" value="" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="arch-72"><mxGeometry x="285" y="103" width="22" height="18" as="geometry"/></mxCell><mxCell id="arch-84" value="IPC bridge" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;" vertex="1" parent="arch-72"><mxGeometry x="315" y="100" width="220" height="24" as="geometry"/></mxCell><mxCell id="arch-85" value="&lt;b&gt;Main flows&lt;/b&gt; (numbers on the arrows)&lt;br&gt;① &lt;b&gt;Ask&lt;/b&gt;: Composer → useChat.ask → ai.streamAnswer → Responses API (streamed deltas) → parseAnswer → Conversation renders question, glance, Details, Follow-ups&lt;br&gt;② &lt;b&gt;Voice&lt;/b&gt;: mic → recorder → LiveTranscript → invoke speech_transcribe (binary body) → speech.rs (Whisper on the GPU) → live text → on stop: final text → ask&lt;br&gt;③ &lt;b&gt;Screenshot&lt;/b&gt;: shortcut → open_snip_window → two clicks → &quot;snip&quot; event → capture_screen (BGRA) → JPEG data URL → ask with image&lt;br&gt;④ &lt;b&gt;Lock&lt;/b&gt;: set_click_through + low-level hooks → Esc / Ctrl+click on the lock → &quot;emergency-unlock&quot; event; Ctrl+wheel → &quot;locked-scroll&quot;&lt;br&gt;⑤ &lt;b&gt;First run / updates&lt;/b&gt;: speech_load → model.rs downloads from Hugging Face (verified) → warm-up pass; updater checks GitHub latest.json, installs only when clicked" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=10;fontSize=11;fillColor=#ffffff;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="620" y="1110" width="1210" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="deploy" name="2 · HLD – Build, release &amp; update"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="deploy-1" value="&lt;b&gt;toyol — Build, release &amp;amp; update&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="18" width="900" height="34" as="geometry"/></mxCell><mxCell id="deploy-2" value="How a version gets from the repository to installed copies, and how the speech model reaches each PC" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="52" width="1200" height="24" as="geometry"/></mxCell><mxCell id="deploy-3" value="Developer PC · Windows, Node 20+, rustup, VS C++ tools, Vulkan SDK, libclang" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;container=1;collapsible=0;verticalAlign=top;align=left;spacingLeft=10;spacingTop=2;fontStyle=1;fontSize=12;fillColor=#f7f7f7;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="560" height="760" as="geometry"/></mxCell><mxCell id="deploy-4" value="&lt;b&gt;npm run release -- 0.2.0 &quot;What changed&quot;&lt;/b&gt;&lt;br&gt;scripts/release.mjs · needs a clean, committed tree" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="deploy-3"><mxGeometry x="30" y="45" width="500" height="60" as="geometry"/></mxCell><mxCell id="deploy-5" value="&lt;b&gt;Set the version&lt;/b&gt;&lt;br&gt;package.json (tauri.conf.json reads it) · Cargo.toml" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="deploy-3"><mxGeometry x="30" y="135" width="500" height="55" as="geometry"/></mxCell><mxCell id="deploy-6" value="&lt;b&gt;npm run tauri:build&lt;/b&gt;&lt;br&gt;tsc -b + vite build → dist/ · cargo build --release (whisper.cpp with Vulkan, CMake, libclang)&lt;br&gt;Cargo target in a short folder (Windows 260-char path limit)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="deploy-3"><mxGeometry x="30" y="220" width="500" height="75" as="geometry"/></mxCell><mxCell id="deploy-7" value="&lt;b&gt;Sign&lt;/b&gt; with the minisign key&lt;br&gt;TAURI_SIGNING_PRIVATE_KEY or ~/.tauri/toyol.key (back it up: installed copies accept only updates signed with it)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fontSize=11;spacing=6;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="deploy-3"><mxGeometry x="30" y="325" width="500" height="65" as="geometry"/></mxCell><mxCell id